{
  "name": "opentext-playwright-framework",
  "version": "1.0.0",
  "description": "AI-powered Playwright test automation framework for OpenText website using @playwright/cli with SKILLS",
  "main": "dist/index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=desktop-chrome",
    "test:firefox": "playwright test --project=desktop-firefox",
    "test:webkit": "playwright test --project=desktop-safari",
    "test:edge": "playwright test --project=desktop-edge",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:tablet": "playwright test --project=tablet-chrome",
    "test:header": "playwright test --grep @Header",
    "test:homepage": "playwright test --grep @Homepage",
    "test:responsive": "playwright test --grep @Responsive",
    "test:smoke": "playwright test --grep @Smoke",
    "test:regression": "playwright test --grep @Regression",
    "test:p0": "playwright test --grep @P0",
    "test:visual": "percy exec --config configs/percy.yml -- playwright test src/tests/visual.spec.ts",
    "test:visual:ci": "percy exec --config configs/percy.yml -- npx playwright test src/tests/visual.spec.ts --grep-invert @Responsive",
    "test:visual:fast": "percy exec --config configs/percy.yml -- npx playwright test src/tests/visual.spec.ts --project=desktop-chrome --grep-invert @Responsive --workers=4",
    "test:visual:full": "percy exec --config configs/percy.yml -- npx playwright test src/tests/visual.spec.ts --project=desktop-chrome --project=viewport-xl --project=viewport-md --project=viewport-sm --project=mobile-chrome --workers=3",
    "test:regression:daily": "playwright test --grep \"@Regression|@P0\" --project=desktop-chrome --project=desktop-firefox --project=desktop-edge --project=mobile-chrome",
    "test:responsive:matrix": "playwright test --grep @Responsive --project=viewport-xl --project=viewport-lg --project=viewport-md --project=viewport-sm --project=viewport-xs",
    "test:report": "playwright show-report",
    "test:ci": "playwright test --reporter=list,json",
    "test:bstack": "cross-env BROWSERSTACK_CONFIG_FILE=configs/browserstack.yml node -r dotenv/config node_modules/browserstack-node-sdk/src/bin/runner.js playwright test",
    "test:bstack:fast": "cross-env BROWSERSTACK_CONFIG_FILE=configs/browserstack.yml node -r dotenv/config node_modules/browserstack-node-sdk/src/bin/runner.js playwright test --workers=4",
    "test:bstack:max": "cross-env BROWSERSTACK_CONFIG_FILE=configs/browserstack.yml node -r dotenv/config node_modules/browserstack-node-sdk/src/bin/runner.js playwright test --workers=5",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "build": "tsc",
    "clean": "rm -rf dist test-results playwright-report ai-debug-report",
    "cli:install": "npm install -g @playwright/cli@latest",
    "cli:open": "playwright-cli open https://www.opentext.com --headed",
    "cli:snapshot": "playwright-cli snapshot",
    "cli:skills": "playwright-cli install --skills"
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "automation",
    "opentext",
    "playwright-cli",
    "ai-testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@percy/cli": "^1.31.12",
    "@percy/playwright": "^1.1.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.6.0",
    "browserstack-node-sdk": "^1.52.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.34.0"
  }
}
